rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isHouseholdMember(householdId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    /** Pilot ops allowlist — keep in sync with src/constants/admin.ts (plus-aliases allowed). */
    // Unverified email matches don't count: anyone can register a password account for an unused alias.
    function isAdmin() {
      return signedIn()
        && (request.auth.token.get('admin', false) == true
          || (request.auth.token.email_verified == true
            && request.auth.token.email is string
            && request.auth.token.email.matches('^(brendan|joseph|maya|shameem)(\\+[^@]*)?@unaffiliated[.]co$')));
    }

    match /users/{userId} {
      allow read, write: if isUser(userId);
      match /children/{childId} {
        allow read, write: if isUser(userId);
      }
      match /aiChats/{threadId} {
        allow read, write: if isUser(userId);
      }
      match /reflection/{holidayId} {
        allow read, write: if isUser(userId);
      }
    }

    /** Credit balances only change in functions (checkout, gift claims, admin grants, debrief award). */
    function creditKeys() {
      return ['giftCreditCents', 'platformCreditCents'];
    }

    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && !request.resource.data.keys().hasAny(creditKeys());
      allow update: if isHouseholdMember(householdId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(creditKeys());
      match /boxDrafts/{holidayId} {
        allow read, write: if isHouseholdMember(householdId);
      }
      match /orders/{orderId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if false;
      }
      match /receivedGifts/{giftId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if false;
      }
      match /partnerInvites/{inviteId} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /content/{holidayId} {
      allow read: if true;
      match /nights/{nightId} {
        allow read: if true;
      }
    }

    match /catalog/{holidayId}/items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /** Live sale / allocation counters — public read; server-only write. */
    match /catalog/{holidayId}/inventory/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    /** Marketing landings CMS — public read; admin write. */
    match /landings/{landingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /waitlist/{entryId} {
      allow create: if signedIn();
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /giftInvites/{inviteId} {
      allow read: if signedIn() && resource.data.giverUid == request.auth.uid;
      allow write: if false;
    }

    /** Guest box recovery (functions/src/guestSessions.ts) — functions only, never clients. */
    match /guestSessions/{visitorId} {
      allow read, write: if false;
    }
    match /guestResumeTokens/{tokenHash} {
      allow read, write: if false;
    }
    match /retentionLeadEvents/{eventId} {
      allow read, write: if false;
    }
    /** Login links + rate-limit windows (functions/src/loginLinks.ts) — functions only. */
    match /loginTokens/{tokenHash} {
      allow read, write: if false;
    }
    match /rateLimits/{keyHash} {
      allow read, write: if false;
    }
    /** Discount codes, credit grants, influencers and their stats (functions/src/promotions.ts) — functions only. */
    match /discountCodes/{code} {
      allow read, write: if false;
    }
    match /creditGrants/{grantId} {
      allow read, write: if false;
    }
    match /creditAwards/{awardId} {
      allow read, write: if false;
    }
    match /influencers/{slug} {
      allow read, write: if false;
    }
    match /influencerVisits/{visitId} {
      allow read, write: if false;
    }
    match /influencerPayouts/{payoutId} {
      allow read, write: if false;
    }
    match /promoRedemptions/{redemptionId} {
      allow read, write: if false;
    }
    /** Server-only settings and hashed lead lists (functions/src/followUpAudience.ts) — functions only. */
    match /adminConfig/{docId} {
      allow read, write: if false;
    }
  }
}
