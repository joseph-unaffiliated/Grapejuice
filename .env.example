# Grapejuice pilot — copy to .env (never commit .env)

# Firebase (grapejuice-pilot project)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Stripe publishable (must match functions STRIPE_SECRET_KEY account)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Sign-In (Firebase Console → Auth → Google → Web client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EAS (optional until native builds)
# EAS_PROJECT_ID=

# Server-side keys live in functions/.env.grapejuice-pilot — see functions/.env.example
