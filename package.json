{
  "name": "grapejuice-pilot",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "deploy:hosting": "npm run build:web && npx firebase-tools deploy --only hosting --project grapejuice-pilot",
    "capture:home": "bash scripts/capture-home-live.sh",
    "capture:home:local": "bash scripts/capture-home-local.sh",
    "capture:passover:local": "bash scripts/capture-home-local.sh",
    "compare:home": "node scripts/compare-home-figma.mjs",
    "compare:home:local": "npm run capture:home:local && node scripts/compare-home-figma.mjs",
    "compare:figma": "node scripts/compare-figma-screen.mjs",
    "compare:checkout": "node scripts/compare-figma-screen.mjs checkout",
    "compare:mybox": "node scripts/compare-figma-screen.mjs mybox",
    "deploy:hosting:verify": "npm run deploy:hosting && npm run capture:home",
    "seed:pilot-content": "node scripts/seed-pilot-content.js",
    "seed:pilot-catalog": "node scripts/seed-pilot-catalog.js",
    "seed:pilot": "npm run seed:pilot-content && npm run seed:pilot-catalog",
    "firebase:deploy:rules": "npx firebase-tools deploy --only firestore:rules,storage --project grapejuice-pilot",
    "firebase:deploy:functions": "npx firebase-tools deploy --only functions --project grapejuice-pilot",
    "postinstall": "node scripts/patch-expo-csp.js"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-native-fontawesome": "^0.3.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/bottom-tabs": "^7.14.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/stack": "^7.7.2",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.7.0",
    "@stripe/stripe-react-native": "0.50.3",
    "expo": "~54.0.33",
    "expo-apple-authentication": "^8.0.8",
    "expo-constants": "^18.0.13",
    "expo-font": "~14.0.11",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.9.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "dotenv": "^17.3.1",
    "firebase-admin": "^13.10.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.52.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
